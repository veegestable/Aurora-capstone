# Firebase Configuration for Aurora Mental Health App 
# (replace with your actual config)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Development Configuration
VITE_APP_NAME=Aurora Mental Health
NODE_ENV=development

# Sign-up / sign-in email policy (keep in sync with mobile EXPO_PUBLIC_* and functions/.env)
# Safer: list specific QA emails — do not disable MSU-IIT rule globally.
VITE_SIGNUP_EMAIL_ALLOWLIST=test@gmail.com,your.qa@example.com
# VITE_REQUIRE_MSUIIT_SIGNUP_EMAIL=false  (dev builds only; ignored in production)
# VITE_ALLOW_UNVERIFIED_SIGNIN=true       (dev only; use allowlist instead when possible)

# Cloud Functions — copy allowlist + AURORA_IDENTITY_WEB_API_KEY to functions/.env (see functions/.env.example)

# AI Emotion Detection API Configuration
VITE_EMOTION_API_URL=your_emotion_api_url

# Weekly Analysis OpenAI API
VITE_OPENROUTER_API_KEY=your_openrouter_openai_api_key