rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthed() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function myRole() {
      return isAuthed() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? userDoc(request.auth.uid).data.role
        : null;
    }

    function isAdmin() {
      return myRole() == 'admin';
    }

    function isCounselor() {
      return myRole() == 'counselor';
    }

    function isOwner(uid) {
      return isAuthed() && request.auth.uid == uid;
    }

    function isCounselorRoleValue(v) {
      return v == 'counselor' || v == 'Counselor';
    }

    function isStudentRoleValue(v) {
      return v == 'student';
    }

    function validCollegeCode(code) {
      return code in ['COE', 'CSM', 'CCS', 'CED', 'CASS', 'CEBA', 'CHS'];
    }

    /** Catalog line must match `src/constants/college-programs-iit.ts`. */
    function ownerCollegeShiftRequestProgramOk(cc, p, role) {
      return isCounselorRoleValue(role) && p is string && p.size() == 0 ||
        catalogProgramBelongsToCollege(cc, p);
    }

    function catalogProgramBelongsToCollege(cc, p) {
      return cc is string && validCollegeCode(cc) && p is string && p.size() > 0 &&
        (
        (cc == 'COE' && p in [
          'Bachelor of Science in Chemical Engineering (BSChe)',
          'Bachelor of Science in Environmental Engineering',
          'Bachelor of Science in Civil Engineering (BSCE)',
          'Bachelor of Science in Computer Engineering (BSCpE)',
          'Bachelor of Science in Electrical Engineering (BSEE)',
          'Bachelor of Science in Electronics and Communication Engineering (BSECE)',
          'Bachelor of Science in Industrial Automation and Mechatronics',
          'Bachelor of Science in Ceramics Engineering',
          'Bachelor of Science in Metallurgical Engineering',
          'Bachelor of Science in Mining Engineering',
          'Bachelor of Science in Mechanical Engineering (BSME)',
          'Bachelor of Engineering Technology Major in Chemical Engineering and Technology',
          'Bachelor of Engineering Technology Major in Civil Engineering Technology (BET-CET)',
          'Bachelor of Engineering Technology Major in Electrical Engineering Technology (BET-EET)',
          'Bachelor of Engineering Technology Major in Electronics Engineering Technology (BET-EST)',
          'Bachelor of Engineering Technology Major in Metallurgical and Materials Engineering Technology (BET-MMT)',
          'Bachelor of Engineering Technology Major in Mechanical Engineering Technology (BET-MET)'
        ]) ||
        (cc == 'CCS' && p in [
          'Bachelor of Science in Information Technology (BSIT)',
          'Bachelor of Science in Computer Science (BSCS)',
          'Bachelor of Science in Information Systems (BSIS)',
          'Bachelor of Science in Computer Applications (BSCA)'
        ]) ||
        (cc == 'CSM' && p in [
          'Bachelor of Science in Biology (General)',
          'Bachelor of Science in Biology (Botany)',
          'Bachelor of Science in Biology (Marine Biology)',
          'Bachelor of Science in Biology (Zoology)',
          'Bachelor of Science in Chemistry',
          'Bachelor of Science in Mathematics',
          'Bachelor of Science in Statistics',
          'Bachelor of Science in Physics'
        ]) ||
        (cc == 'CED' && p in [
          'Bachelor of Elementary Education Science and Mathematics',
          'Bachelor of Secondary Education Biology',
          'Bachelor of Secondary Education Chemistry',
          'Bachelor of Secondary Education Physics',
          'Bachelor of Secondary Education Mathematics',
          'Bachelor of Physical Education',
          'Bachelor of Technology and Livelihood Education Major in Home Economics',
          'Bachelor of Technical-Vocational Teacher Education Major in Drafting Technology',
          'Bachelor of Technology and Livelihood Education Major in Industrial Arts (BTLEd-Industrial Arts)',
          'Bachelor of Elementary Education – Language Education',
          'Bachelor of Secondary Education Filipino'
        ]) ||
        (cc == 'CASS' && p in [
          'Bachelor of Arts in English Language Studies',
          'Bachelor of Arts in Filipino',
          'Bachelor of Arts in History',
          'Bachelor of Arts in Panitikan',
          'Bachelor of Arts in Political Science',
          'Bachelor of Arts in Psychology',
          'Bachelor of Arts in Sociology',
          'Bachelor of Science in Philosophy',
          'Bachelor of Science in Psychology'
        ]) ||
        (cc == 'CEBA' && p in [
          'Bachelor of Science in Accountancy',
          'Bachelor of Science in Economics',
          'Bachelor of Science in Business Administration Major in Business Economics',
          'Bachelor of Science in Business Administration Major in Marketing Management',
          'Bachelor of Science Major in Entrepreneurship',
          'Bachelor of Science in Hospitality Management'
        ]) ||
        (cc == 'CHS' && p in ['Bachelor of Science in Nursing'])
        );
    }

    function validStudentProgramForCollege(d) {
      return d.college_code is string && d.program is string &&
        catalogProgramBelongsToCollege(d.college_code, d.program);
    }

    function counselorProgramFieldForbidden(d) {
      return isCounselorRoleValue(d.role) &&
        d.keys().hasAny(['program']) &&
        d.program is string &&
        d.program.size() > 0;
    }

    function docCollegeCode(d) {
      return (d.keys().hasAny(['college_code']) &&
          d.college_code is string &&
          d.college_code.size() > 0 &&
          validCollegeCode(d.college_code))
        ? d.college_code
        : (d.keys().hasAny(['department']) &&
            d.department is string &&
            d.department.size() > 0 &&
            validCollegeCode(d.department)
            ? d.department
            : '');
    }

    function sameCollegeForUsers(a, b) {
      let ca = docCollegeCode(a);
      let cb = docCollegeCode(b);
      return ca.size() > 0 && ca == cb;
    }

    function userDocData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function ownerUserChangedKeys() {
      return request.resource.data.diff(resource.data).changedKeys();
    }

    function ownerCollegeCodeUpdateOk() {
      return !ownerUserChangedKeys().hasAny(['college_code']) ||
        (
          (
            !(resource.data.keys().hasAny(['college_code']) && resource.data.college_code is string) ||
            resource.data.college_code.size() == 0
          ) &&
          request.resource.data.college_code is string &&
          validCollegeCode(request.resource.data.college_code)
        );
    }

    function ownerCollegeShiftPendingUpdateOk() {
      return !ownerUserChangedKeys().hasAny(['college_shift_pending']) ||
        (
          !(resource.data.keys().hasAny(['college_shift_pending']) && resource.data.college_shift_pending == true) &&
          request.resource.data.college_shift_pending == true
        );
    }

    function ownerCollegeShiftRequestUpdateOk() {
      return !ownerUserChangedKeys().hasAny(['college_shift_request']) ||
        (
          request.resource.data.college_shift_request is map &&
          request.resource.data.college_shift_request.keys().hasOnly(['requested_college_code', 'requested_program', 'reason', 'requested_at']) &&
          ownerCollegeShiftRequestProgramOk(
            request.resource.data.college_shift_request.requested_college_code,
            request.resource.data.college_shift_request.requested_program,
            resource.data.role
          ) &&
          request.resource.data.college_shift_request.reason is string &&
          request.resource.data.college_shift_request.reason.size() >= 8 &&
          request.resource.data.college_shift_request.reason.size() <= 1500 &&
          request.resource.data.college_shift_request.requested_at is timestamp &&
          docCollegeCode(resource.data).size() > 0 &&
          (
            request.resource.data.college_shift_request.requested_college_code != docCollegeCode(resource.data) ||
            (
              isStudentRoleValue(resource.data.role) &&
              request.resource.data.college_shift_request.requested_college_code == docCollegeCode(resource.data) &&
              (
                !(resource.data.keys().hasAny(['program']) && resource.data.program is string && resource.data.program.size() > 0) ||
                request.resource.data.college_shift_request.requested_program != resource.data.program
              )
            )
          )
        );
    }

    /**
     * Firestore stores email_verified for directory queries. Owners may sync it with Auth.
     * Prefer matching the JWT claim; also allow true when token email matches the profile
     * email (covers stale JWT right after the user opens the verification link).
     */
    function ownerEmailVerifiedUpdateOk() {
      let r = resource.data.get('email_verified', null);
      let w = request.resource.data.get('email_verified', null);
      
      return w == r ||
        w == request.auth.token.email_verified ||
        (
          w == true &&
          request.auth.token.email is string &&
          request.resource.data.get('email', null) is string &&
          request.auth.token.email == request.resource.data.email
        );
    }

    /** Counselors have `approval_status`; students usually omit it — avoid broken == on missing vs null. */
    function ownerApprovalStatusUnchanged() {
      let r = resource.data.keys().hasAny(['approval_status']);
      let w = request.resource.data.keys().hasAny(['approval_status']);
      return (!r && !w) ||
        (r && w && request.resource.data.approval_status == resource.data.approval_status);
    }

    function userSensitiveFieldsUnchanged() {
      return request.resource.data.role == resource.data.role &&
        ownerApprovalStatusUnchanged() &&
        ownerEmailVerifiedUpdateOk() &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.created_at == resource.data.created_at &&
        request.resource.data.email == resource.data.email;
    }

    // Owner can edit only profile-safe fields; sensitive identity/role fields stay immutable.
    function ownerUserUpdateValid() {
      return userSensitiveFieldsUnchanged() &&
        ownerUserChangedKeys().hasOnly([
          'full_name',
          'preferred_name',
          'college_code',
          'program',
          'year_level',
          'student_number',
          'contact_number',
          'sex',
          'bio',
          'avatar_url',
          'session_push_notifications_enabled',
          'updated_at',
          'college_shift_request',
          'college_shift_pending',
          'email_verified'
        ]) &&
        ownerCollegeCodeUpdateOk() &&
        ownerCollegeShiftRequestUpdateOk() &&
        ownerCollegeShiftPendingUpdateOk() &&
        !counselorProgramFieldForbidden(request.resource.data) &&
        (
          !isStudentRoleValue(request.resource.data.role) ||
          !ownerUserChangedKeys().hasAny(['program']) ||
          !request.resource.data.keys().hasAny(['program']) ||
          !(request.resource.data.program is string) ||
          request.resource.data.program.size() == 0 ||
          validStudentProgramForCollege(request.resource.data)
        );
    }

    function ownerUserCreateValid(uid) {
      return request.resource.data.uid == uid &&
        request.resource.data.email == request.auth.token.email &&
        (request.resource.data.role == 'student' || request.resource.data.role == 'counselor') &&
        request.resource.data.keys().hasAny(['college_code']) &&
        request.resource.data.college_code is string &&
        validCollegeCode(request.resource.data.college_code) &&
        (
          (request.resource.data.role == 'student' && validStudentProgramForCollege(request.resource.data)) ||
          (request.resource.data.role == 'counselor' && !counselorProgramFieldForbidden(request.resource.data))
        );
    }

    function conversationStructureValid(data) {
      return data.counselorId is string &&
        data.studentId is string &&
        data.counselorId.size() > 0 &&
        data.studentId.size() > 0 &&
        (
          !data.keys().hasAny(['college_code']) ||
          (data.college_code is string &&
            data.college_code.size() > 0 &&
            validCollegeCode(data.college_code))
        );
    }

    /** Participant may re-tag when both are back in the viewer's college (e.g. after transfer return). */
    function conversationCollegeTagRepairAllowed() {
      let viewer = docCollegeCode(userDoc(request.auth.uid).data);
      let conv = resource.data;
      let nextTag = request.resource.data.college_code;
      return viewer.size() > 0 &&
        nextTag is string &&
        validCollegeCode(nextTag) &&
        nextTag == viewer &&
        docCollegeCode(userDocData(conv.counselorId)) == viewer &&
        docCollegeCode(userDocData(conv.studentId)) == viewer;
    }

    function conversationCollegeCodeUnchanged() {
      return isAdmin() ||
        conversationCollegeTagRepairAllowed() ||
        !resource.data.keys().hasAny(['college_code']) ||
        !request.resource.data.keys().hasAny(['college_code']) ||
        request.resource.data.college_code == resource.data.college_code;
    }

    function conversationIdMatchesBody(convId, data) {
      return convId == (data.counselorId + '_' + data.studentId);
    }

    function conversationParticipantsSameCollege(data) {
      return exists(/databases/$(database)/documents/users/$(data.counselorId)) &&
        exists(/databases/$(database)/documents/users/$(data.studentId)) &&
        sameCollegeForUsers(userDocData(data.counselorId), userDocData(data.studentId));
    }

    function sessionCreateParticipantsSameCollege() {
      let cid = request.resource.data.counselorId;
      let sid = request.resource.data.studentId;
      return cid is string && sid is string &&
        exists(/databases/$(database)/documents/users/$(cid)) &&
        exists(/databases/$(database)/documents/users/$(sid)) &&
        sameCollegeForUsers(userDocData(cid), userDocData(sid));
    }

    function conversationCollegeTagFromConvData(data) {
      return data.keys().hasAny(['college_code']) &&
        data.college_code is string &&
        data.college_code.size() > 0
        ? data.college_code
        : '';
    }

    function isActiveCollegeConversation(convId) {
      let conv = get(/databases/$(database)/documents/conversations/$(convId)).data;
      let tag = conversationCollegeTagFromConvData(conv);
      let viewer = docCollegeCode(userDoc(request.auth.uid).data);
      let cCollege = docCollegeCode(userDocData(conv.counselorId));
      let sCollege = docCollegeCode(userDocData(conv.studentId));
      return viewer.size() > 0 &&
        tag.size() > 0 &&
        tag == viewer &&
        cCollege.size() > 0 &&
        cCollege == viewer &&
        sCollege.size() > 0 &&
        sCollege == viewer;
    }

    function isPastCollegeConversation(convId) {
      let viewer = docCollegeCode(userDoc(request.auth.uid).data);
      return viewer.size() > 0 && !isActiveCollegeConversation(convId);
    }

    function isActiveCollegeSession(sessionId) {
      let s = get(/databases/$(database)/documents/sessions/$(sessionId)).data;
      let tag = conversationCollegeTagFromConvData(s);
      let viewer = docCollegeCode(userDoc(request.auth.uid).data);
      let cCollege = s.counselorId is string && s.counselorId.size() > 0
        ? docCollegeCode(userDocData(s.counselorId))
        : '';
      let sCollege = s.studentId is string && s.studentId.size() > 0
        ? docCollegeCode(userDocData(s.studentId))
        : '';
      return viewer.size() > 0 &&
        tag.size() > 0 &&
        tag == viewer &&
        cCollege.size() > 0 &&
        cCollege == viewer &&
        sCollege.size() > 0 &&
        sCollege == viewer;
    }

    function isPastCollegeSession(sessionId) {
      let viewer = docCollegeCode(userDoc(request.auth.uid).data);
      return viewer.size() > 0 && !isActiveCollegeSession(sessionId);
    }

    function messageCreateValid(convId) {
      return request.resource.data.senderId == request.auth.uid &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.isRead == false &&
        isConversationParticipant(convId) &&
        !isPastCollegeConversation(convId);
    }

    function messageUpdateValid(convId) {
      // Sender cannot be rewritten by another participant.
      return request.resource.data.senderId == resource.data.senderId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        !isPastCollegeConversation(convId);
    }

    function validSessionStatus(status) {
      return status in [
        'requested',
        'pending',
        'confirmed',
        'needs_rescheduling',
        'expired',
        'completed',
        'missed',
        'rescheduled',
        'cancelled'
      ];
    }

    function sessionTransitionValid() {
      let old = resource.data.status;
      let next = request.resource.data.status;
      return old == next ||
        (old == 'requested' && (next == 'pending' || next == 'confirmed' || next == 'cancelled' || next == 'expired')) ||
        (old == 'pending' && (next == 'confirmed' || next == 'needs_rescheduling' || next == 'cancelled' || next == 'expired')) ||
        (old == 'confirmed' && (next == 'completed' || next == 'missed' || next == 'needs_rescheduling' || next == 'cancelled' || next == 'expired')) ||
        (old == 'needs_rescheduling' && (next == 'pending' || next == 'cancelled' || next == 'expired' || next == 'completed' || next == 'missed')) ||
        (old == 'expired' && (next == 'completed' || next == 'missed' || next == 'cancelled')) ||
        (old == 'rescheduled' && (next == 'pending' || next == 'cancelled' || next == 'expired'));
    }

    function isConversationParticipant(convId) {
      return exists(/databases/$(database)/documents/conversations/$(convId)) && (
        get(/databases/$(database)/documents/conversations/$(convId)).data.counselorId == request.auth.uid ||
        get(/databases/$(database)/documents/conversations/$(convId)).data.studentId == request.auth.uid ||
        isAdmin()
      );
    }

    function isSessionParticipant(sessionId) {
      return exists(/databases/$(database)/documents/sessions/$(sessionId)) && (
        get(/databases/$(database)/documents/sessions/$(sessionId)).data.counselorId == request.auth.uid ||
        get(/databases/$(database)/documents/sessions/$(sessionId)).data.studentId == request.auth.uid ||
        isAdmin()
      );
    }

    /** conversations/{counselorId}_{studentId} — student may only notify their assigned counselor. */
    function canStudentNotifyCounselorRecipient() {
      let recipient = request.resource.data.user_id;
      let convId = recipient + '_' + request.auth.uid;
      return myRole() == 'student'
        && exists(/databases/$(database)/documents/conversations/$(convId))
        && get(/databases/$(database)/documents/conversations/$(convId)).data.counselorId == recipient
        && get(/databases/$(database)/documents/conversations/$(convId)).data.studentId == request.auth.uid;
    }

    function canCounselorNotifyStudentRecipient() {
      let recipient = request.resource.data.user_id;
      let convId = request.auth.uid + '_' + recipient;
      return myRole() == 'counselor'
        && exists(/databases/$(database)/documents/conversations/$(convId))
        && get(/databases/$(database)/documents/conversations/$(convId)).data.counselorId == request.auth.uid
        && get(/databases/$(database)/documents/conversations/$(convId)).data.studentId == recipient;
    }

    function announcementReaderExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function announcementLegacyReadOk(d) {
      let me = userDoc(request.auth.uid).data;
      let tr = d.keys().hasAny(['targetRole']) && d.targetRole is string ? d.targetRole : 'all';
      return tr == 'all' ||
        (tr == 'student' && isStudentRoleValue(me.role)) ||
        (tr == 'counselor' && isCounselorRoleValue(me.role));
    }

    function collegeInAnnouncementCodes(college, d) {
      return d.keys().hasAny(['collegeCodes']) && d.collegeCodes is list && college in d.collegeCodes;
    }

    function announcementModernReadOk(d) {
      let me = userDoc(request.auth.uid).data;
      let college = docCollegeCode(me);
      let vis = d.visibility;
      return d.createdBy == request.auth.uid ||
        (vis == 'students_all' && isStudentRoleValue(me.role)) ||
        (vis == 'counselors_all' && isCounselorRoleValue(me.role)) ||
        (vis == 'colleges_cross' && college.size() > 0 &&
          (isStudentRoleValue(me.role) || isCounselorRoleValue(me.role)) &&
          collegeInAnnouncementCodes(college, d)) ||
        (vis == 'students_one_college' && college.size() > 0 &&
          collegeInAnnouncementCodes(college, d) &&
          (isStudentRoleValue(me.role) || isCounselorRoleValue(me.role)));
    }

    function announcementReadOk(d) {
      return announcementReaderExists() && (
        !d.keys().hasAny(['visibility'])
          ? announcementLegacyReadOk(d)
          : announcementModernReadOk(d)
      );
    }

    function announcementCollegeCodesCreateOk(arr) {
      return arr is list && arr.size() >= 1 && arr.size() <= 7 &&
        arr[0] is string && validCollegeCode(arr[0]) &&
        (arr.size() < 2 || (arr[1] is string && validCollegeCode(arr[1]))) &&
        (arr.size() < 3 || (arr[2] is string && validCollegeCode(arr[2]))) &&
        (arr.size() < 4 || (arr[3] is string && validCollegeCode(arr[3]))) &&
        (arr.size() < 5 || (arr[4] is string && validCollegeCode(arr[4]))) &&
        (arr.size() < 6 || (arr[5] is string && validCollegeCode(arr[5]))) &&
        (arr.size() < 7 || (arr[6] is string && validCollegeCode(arr[6])));
    }

    function adminAnnouncementCreateOk(d) {
      return d.publisherRole == 'admin' &&
        (d.visibility == 'students_all' || d.visibility == 'counselors_all' ||
          (d.visibility == 'colleges_cross' && announcementCollegeCodesCreateOk(d.collegeCodes))) &&
        ((d.visibility == 'students_all' || d.visibility == 'counselors_all')
          ? (!d.keys().hasAny(['collegeCodes']) || (d.collegeCodes is list && d.collegeCodes.size() == 0))
          : true);
    }

    function counselorAnnouncementCreateOk(d) {
      let me = userDoc(request.auth.uid).data;
      let myCc = docCollegeCode(me);
      return d.publisherRole == 'counselor' &&
        d.visibility == 'students_one_college' &&
        d.collegeCodes is list && d.collegeCodes.size() == 1 &&
        myCc.size() > 0 &&
        d.collegeCodes[0] is string &&
        d.collegeCodes[0] == myCc;
    }

    function announcementCreateShapeOk(d) {
      return d.keys().hasAll([
          'title', 'content', 'createdBy', 'createdByName', 'createdAt', 'updatedAt',
          'publisherRole', 'visibility', 'targetRole', 'collegeCodes'
        ]) &&
        d.title is string && d.title.size() > 0 && d.title.size() <= 300 &&
        d.content is string && d.content.size() > 0 && d.content.size() <= 20000 &&
        d.createdBy is string && d.createdBy == request.auth.uid &&
        d.createdByName is string && d.createdByName.size() > 0 &&
        d.createdAt is timestamp && d.updatedAt is timestamp &&
        d.collegeCodes is list &&
        (d.targetRole == 'student' || d.targetRole == 'counselor' || d.targetRole == 'all');
    }

    function announcementCreateOk() {
      let d = request.resource.data;
      return announcementCreateShapeOk(d) &&
        (
          (isAdmin() && adminAnnouncementCreateOk(d)) ||
          (isCounselor() && counselorAnnouncementCreateOk(d))
        );
    }

    function announcementUpdateDiffKeys() {
      return request.resource.data.diff(resource.data).changedKeys();
    }

    function counselorAnnouncementAuthorUpdateOk() {
      return !isCounselor() ||
        !announcementUpdateDiffKeys().hasAny(['visibility', 'collegeCodes', 'publisherRole']);
    }

    function announcementUpdateOk() {
      return isAdmin() || (
        resource.data.createdBy == request.auth.uid &&
        counselorAnnouncementAuthorUpdateOk()
      );
    }

    match /users/{uid} {
      // Directory policy:
      // - students can read only verified + admin-approved counselors
      // - counselors can read only verified students
      // - owner/admin always allowed
      allow read: if isAuthed() && (
        isOwner(uid) ||
        isAdmin() ||
        (
          myRole() == 'student' &&
          isCounselorRoleValue(resource.data.role) &&
          resource.data.email_verified == true &&
          resource.data.approval_status == 'approved' &&
          sameCollegeForUsers(userDoc(request.auth.uid).data, resource.data)
        ) ||
        (
          myRole() == 'counselor' &&
          isStudentRoleValue(resource.data.role) &&
          resource.data.email_verified == true &&
          sameCollegeForUsers(userDoc(request.auth.uid).data, resource.data)
        ) ||
        (
          myRole() == 'counselor' &&
          isCounselorRoleValue(resource.data.role) &&
          sameCollegeForUsers(userDoc(request.auth.uid).data, resource.data)
        )
      );
      allow create: if isAdmin() || (
        isOwner(uid) &&
        ownerUserCreateValid(uid)
      );
      allow update: if isAdmin() || (
        isOwner(uid) &&
        ownerUserUpdateValid()
      );
      allow delete: if isAdmin();

      /** Expo / FCM routing tokens — owner (+ admin) only; not visible on parent user profile reads. */
      match /private/{docId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
    }

    match /announcements/{id} {
      allow read: if isAuthed() && (isAdmin() || announcementReadOk(resource.data));
      allow create: if isAuthed() && announcementCreateOk();
      allow update: if isAuthed() && announcementUpdateOk();
      allow delete: if isAuthed()
        && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    match /conversations/{id} {
      allow read: if isAuthed() && (
        resource.data.counselorId == request.auth.uid ||
        resource.data.studentId == request.auth.uid ||
        isAdmin()
      );

      allow create: if isAuthed() && (
        conversationStructureValid(request.resource.data) &&
        conversationIdMatchesBody(id, request.resource.data) &&
        conversationParticipantsSameCollege(request.resource.data) &&
        (
          request.resource.data.counselorId == request.auth.uid ||
          request.resource.data.studentId == request.auth.uid ||
          isAdmin()
        )
      );

      allow update: if isAuthed() && (
        conversationStructureValid(resource.data) &&
        conversationStructureValid(request.resource.data) &&
        conversationIdMatchesBody(id, resource.data) &&
        conversationIdMatchesBody(id, request.resource.data) &&
        request.resource.data.counselorId == resource.data.counselorId &&
        request.resource.data.studentId == resource.data.studentId &&
        conversationCollegeCodeUnchanged() &&
        (
          resource.data.counselorId == request.auth.uid ||
          resource.data.studentId == request.auth.uid ||
          isAdmin()
        )
      );

      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow read: if isAuthed() && isConversationParticipant(id);
        allow create: if isAuthed() && messageCreateValid(id);
        allow update: if isAuthed() && isConversationParticipant(id) && messageUpdateValid(id);
        allow delete: if isAuthed() && !isPastCollegeConversation(id) && (
          isConversationParticipant(id) ||
          resource.data.senderId == request.auth.uid
        );
      }
    }

    match /sessions/{id} {
      allow read: if isAuthed() && (
        resource.data.counselorId == request.auth.uid ||
        resource.data.studentId == request.auth.uid ||
        isAdmin()
      );

      allow create: if isAuthed() && (
        validSessionStatus(request.resource.data.status) &&
        request.resource.data.counselorId is string &&
        request.resource.data.studentId is string &&
        sessionCreateParticipantsSameCollege() &&
        (
          !request.resource.data.keys().hasAny(['college_code']) ||
          (request.resource.data.college_code is string &&
            request.resource.data.college_code.size() > 0 &&
            validCollegeCode(request.resource.data.college_code))
        ) &&
        (
          request.resource.data.counselorId == request.auth.uid ||
          request.resource.data.studentId == request.auth.uid ||
          isAdmin()
        )
      );

      allow update: if isAuthed() && (
        validSessionStatus(request.resource.data.status) &&
        sessionTransitionValid() &&
        request.resource.data.counselorId == resource.data.counselorId &&
        (
          request.resource.data.studentId == resource.data.studentId ||
          (resource.data.studentId == null && request.resource.data.studentId == request.auth.uid)
        ) &&
        (
          !resource.data.keys().hasAny(['college_code']) ||
          !request.resource.data.keys().hasAny(['college_code']) ||
          request.resource.data.college_code == resource.data.college_code
        ) &&
        !isPastCollegeSession(id) &&
        (
          resource.data.counselorId == request.auth.uid ||
          resource.data.studentId == request.auth.uid ||
          (resource.data.studentId == null && request.resource.data.studentId == request.auth.uid) ||
          isAdmin()
        )
      );

      allow delete: if isAdmin();
    }

    match /session_notes/{id} {
      allow read: if isAuthed() && (
        resource.data.counselorId == request.auth.uid ||
        isSessionParticipant(resource.data.sessionId)
      );

      allow create: if isAuthed() && (
        request.resource.data.counselorId == request.auth.uid || isAdmin()
      );

      allow update, delete: if isAuthed() && (
        resource.data.counselorId == request.auth.uid || isAdmin()
      );
    }

    match /counselor_notes/{id} {
      allow read: if isAuthed() && (
        (
          resource.data.counselorId == request.auth.uid &&
          resource.data.studentId is string &&
          exists(/databases/$(database)/documents/users/$(resource.data.studentId)) &&
          sameCollegeForUsers(
            userDocData(request.auth.uid),
            userDocData(resource.data.studentId)
          )
        ) ||
        resource.data.studentId == request.auth.uid ||
        isAdmin()
      );

      allow create: if isAuthed() && (
        request.resource.data.counselorId == request.auth.uid || isAdmin()
      );

      allow update, delete: if isAuthed() && (
        resource.data.counselorId == request.auth.uid || isAdmin()
      );
    }

    match /moodLogs/{uid}/entries/{entryId} {
      allow read: if isAuthed() && (
        request.auth.uid == uid ||
        isAdmin() ||
        (
          isCounselor() &&
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          exists(/databases/$(database)/documents/users/$(uid)) &&
          sameCollegeForUsers(userDocData(request.auth.uid), userDocData(uid))
        )
      );
      allow create, update, delete: if isAuthed() && request.auth.uid == uid;
    }

    match /mood_logs/{id} {
      allow read: if isAuthed() && (
        resource.data.user_id == request.auth.uid ||
        isAdmin() ||
        (
          isCounselor() &&
          resource.data.user_id is string &&
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          exists(/databases/$(database)/documents/users/$(resource.data.user_id)) &&
          sameCollegeForUsers(
            userDocData(request.auth.uid),
            userDocData(resource.data.user_id)
          )
        )
      );
      allow create: if isAuthed() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isAuthed() && resource.data.user_id == request.auth.uid;
    }

    match /notifications/{id} {
      allow read: if isAuthed() && (
        resource.data.user_id == request.auth.uid || isAdmin()
      );
      // Self, admin, counselor (e.g. session invite before conversation exists), or
      // student notifying their counselor via an existing conversation doc.
      allow create: if isAuthed() && (
        request.resource.data.user_id == request.auth.uid ||
        isAdmin() ||
        canStudentNotifyCounselorRecipient() ||
        canCounselorNotifyStudentRecipient()
      );
      allow update, delete: if isAuthed() && (
        resource.data.user_id == request.auth.uid || isAdmin()
      );
    }

    match /resources/{id} {
      allow read: if isAuthed();
      allow create, update, delete: if isAuthed() && (isAdmin() || isCounselor());
    }

    match /schedules/{id} {
      allow read: if isAuthed();
      allow create, update, delete: if isAuthed() && (isAdmin() || isCounselor());
    }

    match /audit_logs/{id} {
      allow read: if isAdmin();
      // Prevent forged audit rows: performer must match caller (admin may still write if you add that path).
      allow create: if isAuthed() && (
        isAdmin() ||
        request.resource.data.performedBy == request.auth.uid
      );
      allow update, delete: if false;
    }

    match /userSettings/{uid} {
      // Counselors read student settings for journal-access + check-in context; peers cannot.
      allow read: if isAuthed() && (
        isOwner(uid) ||
        isAdmin() ||
        (
          isCounselor() &&
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          exists(/databases/$(database)/documents/users/$(uid)) &&
          sameCollegeForUsers(userDocData(request.auth.uid), userDocData(uid))
        )
      );
      allow create, update: if isOwner(uid) || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();
    }

    // Student mood calendar context written during MoodCheckIn save flow.
    match /dailyContext/{uid} {
      allow read, create, update, delete: if isOwner(uid) || isAdmin();

      match /days/{dayKey} {
        allow read, create, update, delete: if isOwner(uid) || isAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
