# Firebase Configuration for Aurora Mental Health App (Mobile)
# Copy values from your web .env file.
# Same variables populate JS Firebase (src/services/firebase.ts) and iOS
# GoogleService-Info.plist (generated at prebuild — keep mobile/GoogleService-Info.plist gitignored).

EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id
# Realtime Database URL for online/offline presence (optional if you use default: https://PROJECT_ID-default-rtdb.firebaseio.com)
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
EXPO_PUBLIC_EMOTION_API_URL=https://sh00py-aurora-ai-backend.hf.space

# Development Configuration
EXPO_PUBLIC_APP_NAME=Aurora Mental Health
NODE_ENV=development

# New sign-ups default to @g.msuiit.edu.ph only (sign-in unchanged). Bypass per-email:
# EXPO_PUBLIC_SIGNUP_EMAIL_ALLOWLIST=test@gmail.com,your.qa@example.com
# Or turn off the suffix rule entirely (e.g. open QA builds):
# EXPO_PUBLIC_REQUIRE_MSUIIT_SIGNUP_EMAIL=false

# Sign-in requires a verified email unless the address is in SIGNUP_EMAIL_ALLOWLIST above.
# Set to true to allow any account to sign in without clicking the verification link (dev only):
# EXPO_PUBLIC_ALLOW_UNVERIFIED_SIGNIN=true