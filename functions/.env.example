# Cloud Functions — copy to functions/.env (never commit .env)
# Use the Web app apiKey from Firebase Console → Project settings → Your apps → Web

AURORA_IDENTITY_WEB_API_KEY=your_api_key_here

# QA emails that may sign up without @g.msuiit.edu.ph (must match web + mobile allowlists)
SIGNUP_EMAIL_ALLOWLIST=test@gmail.com,your.qa@example.com

# Do NOT set in production. Only works in the Functions emulator:
# REQUIRE_MSUIIT_SIGNUP_EMAIL=false

# Scheduled Auth cleanup (cleanupUnverifiedAuthUsers) — unverified accounts older than grace period
# UNVERIFIED_AUTH_CLEANUP_GRACE_HOURS=72
# UNVERIFIED_AUTH_CLEANUP_DISABLED=true
